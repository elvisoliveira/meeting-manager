include utils
| {{#if meetings.length}}
each type in Object.keys(subtitles)
  style.
      span.#{type} {
        background-color: #{subtitles[type].color};
      }
table#main.table.table-striped-columns.table-hover.m-0
  thead
    tr
      th.col-corner(scope='col')
        div
          +icon('sort')(
            data-tip='{{ i18n \'TIP_SORT\' }}'
            data-tip-placement='bottom'
            tabindex='0'
            role='button'
            aria-label='{{ i18n \'TIP_SORT\' }}'
          )
          +icon('print')(
            data-tip='{{ i18n \'TIP_PRINT\' }}'
            data-tip-placement='bottom'
            tabindex='0'
            role='button'
            aria-label='{{ i18n \'TIP_PRINT\' }}'
          )
      | {{#each meetings}}
      th(
        class='col-toggle{{#if this.data.message}} event{{/if}}'
        scope='col'
        data-tip-placement='bottom'
        data-tip=`${columnBadge}`
      )
        div
          input(
            type='checkbox'
            id='{{@key}}'
            value='{{this.date}}'
            aria-label='{{ i18n \'TIP_COL_OFF\' }}'
          )
          +icon('sort')(
            tabindex='0'
            role='button'
            aria-label='{{ i18n \'TIP_SORT\' }}'
          )
          label(for='{{@key}}') {{this.label}}
      | {{/each}}
      th(
        scope='col'
        data-tip='{{ i18n \'NO_ASSIGNMENTS\' }}'
        data-tip-placement='bottom'
      )
        div
          +icon('sort')(
            tabindex='0'
            role='button'
            aria-label='{{ i18n \'TIP_SORT\' }}'
          )
  tbody
    | {{#each data as |value key|}}
    tr
      th(
        scope='row'
        data-tip-placement='right'
        data-tip=`${partners}`
      )
        +icon('minus-square hide')(
          tabindex='0'
          role='button'
          aria-label='{{ i18n \'TIP_HIDE_ROW\' }}'
        )
        +icon('copy copy')(
          tabindex='0'
          role='button'
          aria-label='{{ i18n \'TIP_COPY_NAME\' }}'
        )
        | {{this.name}}
      | {{#each this.meetings}}
      td(
          class="{{#if this.data.message}}event{{else}}{{includes this.date value.absences}}{{/if}}"
      )
        div
          | {{#each this.assignments}}
          span(
            onclick="getS89({{this.ID}})"
            class="badge {{this.assignment}}"
            data-tip=`${tooltip}`
          )
            | {{this.assignment}}
          | {{/each}}
      | {{/each}}
      td
        +icon('hashtag')
    | {{/each}}
  tfoot
    tr
      th
        +icon('asterisk')
      td(colspan='{{meetings.length}}' style='text-align: center') {{ i18n 'NO_DATA' }}
      td
        +icon('hashtag')
#floating-actions
  button#permissions.btn.btn-warning.btn-sm(type='button')
    +icon('warning')
    | &nbsp; {{ i18n 'GRANT_PERMISSIONS' }}
  button#draggable.btn.btn-primary.btn-sm(
    type='button'
    data-bs-toggle='modal'
    data-bs-target='#filters'
    aria-label="{{ i18n 'SETTINGS' }}"
  )
    +icon('arrows')
    | &nbsp; {{ i18n 'SETTINGS' }}
| {{else}}
.drag-area(role='button' tabindex='0')
  +icon('upload')
  span.header {{ i18n 'DRAG_AND_DROP' }}
  span.hint {{ i18n 'DRAG_AND_DROP_HINT' }}
  span.actions
    span#browse.button {{ i18n 'BROWSE' }}
    | &nbsp; {{ i18n 'OR' }} &nbsp;
    span#sample.button {{ i18n 'VIEW_SAMPLE' }}
  span.support {{ i18n 'SUPPORTS' }}: JSON
  input(type='file' multiple='' hidden='' accept='.json')
| {{/if}}